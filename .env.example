NODE_ENV=development
PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=sagi
DB_PASSWORD=sagi_dev_password
DB_NAME=sagi
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT / sesión (access corto + refresh rotativo con ventana deslizante)
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_de_minimo_32_caracteres
JWT_ACCESS_TTL_SECONDS=300
REFRESH_TTL_SECONDS=900
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200,http://localhost:3001

# Swagger en /api/docs (debe ser false en producción)
SWAGGER_ENABLED=true

# true si la API está detrás de un proxy/balanceador (para que el límite de peticiones use la IP real)
TRUST_PROXY=false

# Solo para `npm run seed` (primer super administrador)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_EMAIL=superadmin@sagi.local
SEED_SUPERADMIN_FULLNAME=Super Administrador
# Contraseña temporal: el sistema obliga a cambiarla en el primer ingreso
SEED_SUPERADMIN_PASSWORD=CambiaEsta123
